# Parte diario en línea. Copiar a .env (chmod 600); .env no se sube al repositorio.

# Credenciales de Dropbox: las mismas de la app Evidencias en Vercel.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Contraseña de la base local (PostgreSQL en Docker, sin puertos expuestos). Va dentro de la URL de conexión,
# así que sin / + =:   openssl rand -base64 32 | tr -d '/+='
# No cambiarla después del primer arranque: la base ya queda creada con ella.
PARTE_DB_PASSWORD=

# Opcionales (valor por defecto entre paréntesis)
# PARTE_INTERVALO=60          # segundos entre ciclos
# PARTE_REPOSO_MIN=10         # minutos sin cambios en la planilla antes de regenerarla
# PARTE_RESPALDO_DROPBOX=     # carpeta de Dropbox para el pg_dump diario (sin valor: no respalda)
# PARTE_RESPALDO_HORA=03:30
